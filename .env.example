# smart-photo-frame — environment template.
#
#   cp .env.example .env && $EDITOR .env
#
# This file is committed on purpose (.gitignore ignores `.env.*` and then
# negates this one name with `!.env.example`). PUT NO REAL SECRETS IN IT.
# `.env` itself is ignored — that is where the real values go.
#
# Every variable server.js reads is listed below. Only three are required:
# HA_BASE_URL, HA_TOKEN and FRAME_KEY. Everything else has a default and can be
# deleted from your .env entirely.
#
# Out-of-range or malformed values are a BOOT FAILURE, not a runtime surprise:
# the process prints `configuration error: ...` on stderr and exits 1. It
# reports ONLY THE FIRST VIOLATION, so a value you fix can reveal another one
# hiding behind it. Fix, restart, read the next message.
#
# Bounds enforced by server.js (validated in roughly this order — note that
# HA_POLL_MS is checked before PORT):
#
#     PORT                  1 .. 65535        default 3000
#     HA_POLL_MS            1000 .. 3600000   default 10000
#     SCAN_MS               5000 .. 86400000  default 300000
#     HA_REPROBE_EVERY      1 .. 10000        default 30
#     MAX_PHOTOS_PER_ALBUM  1 .. 200000       default 5000
#     AUTH_MAX_FAILS        1 .. 1000         default 10
#     AUTH_WINDOW_MS        1000 .. 86400000  default 900000
#
# Values must be exact integers: 1e4, 10_000 and "5000ms" are all rejected.
#
# NOTE: docker-compose.yaml supplies its own, more responsive defaults for
# HA_POLL_MS (5000), SCAN_MS (60000), HA_REPROBE_EVERY (12),
# MAX_PHOTOS_PER_ALBUM (500) and AUTH_WINDOW_MS (60000), and hard-codes
# TRUST_PROXY=1. Anything you set here overrides those.
#
# See README.md for the operator-facing setup.


# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------

# Port the service listens on. Coolify terminates TLS and routes to this port.
# 1 .. 65535, default 3000.
PORT=3000


# ---------------------------------------------------------------------------
# Home Assistant — REQUIRED
# ---------------------------------------------------------------------------

# Primary route to Home Assistant, over the private tailnet.
#
# Use the RAW 100.x.y.z Tailscale address, not a MagicDNS / *.ts.net name: the
# container gets Docker's resolver, not the host's, so tailnet hostnames do not
# resolve inside it. http: or https: only, no embedded credentials; a trailing
# slash is stripped. Validated at boot, before the token is ever sent to it.
HA_BASE_URL=http://100.101.102.103:8123

# Optional secondary route, used only while the primary is failing — normally
# the Nabu Casa URL. Failover is automatic, and the primary is re-probed every
# HA_REPROBE_EVERY poll cycles so the service returns to the tailnet on its own.
# Leave blank for no fallback. IGNORED if it is identical to HA_BASE_URL.
HA_BASE_URL_FALLBACK=https://your-instance.ui.nabu.casa

# Long-lived access token: HA profile page -> Security -> Long-lived access
# tokens -> Create token.
#
# THIS TOKEN HAS FULL API SCOPE. Home Assistant has no read-only token, so it
# can unlock doors, read cameras and call any service in your house. It is the
# most valuable thing in this deployment. It never leaves the server: no browser
# ever receives it, HA redirects are refused rather than followed, and the
# logger never prints it. Leave blank here.
HA_TOKEN=


# ---------------------------------------------------------------------------
# Frame access — REQUIRED
# ---------------------------------------------------------------------------

# Shared secret for the frame. Generate one:
#
#     openssl rand -hex 24
#
# The server rejects a weak value at boot: at least 16 characters, at most 512,
# printable ASCII with no spaces (it travels in a URL query string), at least 8
# distinct characters, and not a well-known placeholder such as "changeme".
#
# Onboard a device by opening https://frame.example.com/?k=<FRAME_KEY> once; the
# server sets a 400-day __Host- cookie and 303-redirects to the bare path so the
# secret does not persist in history, Referer headers or proxy logs. The cookie
# holds an HMAC of this key, not the key itself.
#
# This is a shared secret, NOT authentication: no identity, no expiry, and no
# revocation short of changing it and re-onboarding every device. Leave blank.
FRAME_KEY=


# ---------------------------------------------------------------------------
# Photos
# ---------------------------------------------------------------------------

# Root of the album tree: one subdirectory per album, no nesting. Mounted from a
# persistent volume, read-only. Default /photos.
PHOTOS_DIR=/photos

# Hard cap on files served per album. The file list is sorted before it is
# capped, so the subset is stable across rescans.
# 1 .. 200000, default 5000.
MAX_PHOTOS_PER_ALBUM=5000

# How often the album tree is rescanned, so new photos appear without a restart.
# 5000 .. 86400000 ms, default 300000 (5 minutes).
SCAN_MS=300000


# ---------------------------------------------------------------------------
# Polling
# ---------------------------------------------------------------------------

# How often Home Assistant is polled. The per-request HA timeout is derived from
# this as clamp(HA_POLL_MS - 1000, 2000, 15000), so it is not separately tunable.
# 1000 .. 3600000 ms, default 10000.
HA_POLL_MS=10000

# While running on the fallback route, try the primary first every N poll
# cycles. At HA_POLL_MS=10000 and 30, that is a re-probe every 5 minutes.
# 1 .. 10000, default 30.
HA_REPROBE_EVERY=30


# ---------------------------------------------------------------------------
# Rate limiting and proxy trust
# ---------------------------------------------------------------------------

# Failed auth attempts allowed per client address per window before 429.
# Cookie holders are never counted and never throttled.
# 1 .. 1000, default 10.
AUTH_MAX_FAILS=10

# Length of that failure window.
# 1000 .. 86400000 ms, default 900000 (15 minutes).
AUTH_WINDOW_MS=900000

# Serve a valid ?k= request directly instead of redirecting to the bare path.
#
# Leave this false unless you add the frame to an iOS home screen. A home-screen
# web app keeps its own cookie store, separate from Safari's, so it can never
# receive a cookie set during a Safari session — and the usual 303 would drop it
# on a bare path holding no cookie at all. With this set, the icon URL carries
# ?k= on every launch and each launch authenticates on its own.
#
# The tradeoff: the key is stored in the icon URL on the device and appears in
# the access log of every proxy in front of this service. Referrer-Policy:
# no-referrer already stops it leaking cross-origin via Referer.
#
# true/1 or false/0 — anything else is a boot failure. Default false. The
# effective value is printed in the boot log line as "allowQueryKey".
# ALLOW_QUERY_KEY=false

# SET THIS TO 1 BEHIND A REVERSE PROXY (Coolify, Caddy, nginx, Traefik).
#
# The default is false, which is correct only when the service faces the
# internet directly — otherwise any client could name its own address in
# X-Forwarded-For and evade per-IP throttling entirely.
#
# Behind a proxy, omitting it means every request appears to come from the proxy
# and the auth limiter collapses into ONE GLOBAL BUCKET: measured behaviour is
# twelve failed attempts from a single address returning 429 to a completely
# unrelated client, locking the real frame out. With 1 the same test returns 429
# to the attacker, 401 to the bystander and 200 to a cookie holder.
#
# 1 means "trust exactly one proxy hop"; count your hops if you have more. Also
# accepts true, false, loopback, uniquelocal, or a comma-separated address list.
# The effective value is printed in the boot log line as "trustProxy".
TRUST_PROXY=1


# ---------------------------------------------------------------------------
# Home Assistant entity IDs
# ---------------------------------------------------------------------------
#
# The four helpers, created via Settings -> Devices & Services -> Helpers. These
# defaults are what the server expects, so you only need these lines if your
# entity IDs differ. Each must look like domain.object_id or boot fails.
#
# The album dropdown's OPTIONS must match the album directory names under
# PHOTOS_DIR exactly — the comparison is a literal string compare.

# Dropdown: which album is showing.
ENTITY_ALBUM=input_select.photo_frame_album

# Toggle: on = show photos, off = black screen.
ENTITY_DISPLAY=input_boolean.photo_frame_display

# Number, 10 .. 100: screen brightness. The server clamps to 10..100, so a
# helper with a minimum of 0 still never dims past 10.
ENTITY_BRIGHTNESS=input_number.photo_frame_brightness

# Number, seconds per photo. The server clamps to 1..3600, but the client page
# enforces its own 5-second floor, so values below 5 have no visible effect.
ENTITY_INTERVAL=input_number.photo_frame_interval
