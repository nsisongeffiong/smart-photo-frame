# Copy these into the Coolify resource's Environment Variables (not into git).

# --- required ---------------------------------------------------------------
# 12-128 characters. Tick "Is Literal" in Coolify if it contains a $ sign.
UPLOAD_PASSWORD=

# --- file ownership (required on most hosts) --------------------------------
# Run:  stat -c '%u:%g' /srv/photos   and put the two numbers here.
UPLOAD_UID=1000
UPLOAD_GID=1000
PHOTOS_HOST_DIR=/srv/photos

# --- optional ---------------------------------------------------------------
# Fixed secret so logins survive a restart (32+ chars): openssl rand -hex 32
SESSION_SECRET=
SESSION_HOURS=168
MAX_UPLOAD_MB=40
MAX_EDGE=2560
JPEG_QUALITY=82
FRAME_MAX_PHOTOS_PER_ALBUM=500
# Also available, with these defaults (all forwarded by docker-compose.yaml):
# MAX_PIXELS=50000000  PROCESS_CONCURRENCY=1  MIN_FREE_MB=500
# AUTH_MAX_FAILS=10  AUTH_WINDOW_MS=900000  LOG_LEVEL=info
# TRUST_PROXY=1 (2 if Cloudflare's proxy is on)  COOKIE_SECURE=true
